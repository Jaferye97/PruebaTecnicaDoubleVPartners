CREATE DATABASE Partners_PruebaTecnica;
GO

USE Partners_PruebaTecnica;

CREATE TABLE Ticket (
    Id INT IDENTITY(1,1) NOT NULL,
    Usuario NVARCHAR(100) NOT NULL,
    FechaCreacion DATETIME2 NOT NULL,
    FechaActualizacion DATETIME2 NULL,
    Estatus NVARCHAR(20) NOT NULL
);
GO

ALTER TABLE Ticket ADD CONSTRAINT PK_Ticket PRIMARY KEY (Id);
GO

ALTER TABLE Ticket ADD CONSTRAINT DF_Ticket_FechaCreacion DEFAULT (GETUTCDATE()) FOR FechaCreacion;
GO

ALTER TABLE Ticket ADD CONSTRAINT DF_Ticket_Estatus DEFAULT ('Abierto') FOR Estatus;
GO

ALTER TABLE Ticket ADD CONSTRAINT CK_Ticket_Estatus CHECK (Estatus IN ('Abierto', 'Cerrado'));
GO

